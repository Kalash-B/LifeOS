# ─── Database / cache (docker compose) ──────────────────────────────────────
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://lifeos:change-me@localhost:55432/lifeos?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
# Required in production, at least 32 random characters: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Session limit when "Keep me logged in" is unchecked
SHORT_SESSION_TTL_HOURS=12

# ─── App ────────────────────────────────────────────────────────────────────
# Allowed browser origin(s) for the API, comma-separated
APP_URL=http://localhost:3000
# Background reminder worker (BullMQ on Redis)
JOBS_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Proxy hops in front of the API that append X-Forwarded-For (Nginx = 1)
TRUST_PROXY_HOPS=1
# Shared with the web app so it can forward the visitor's IP for rate limiting (Vercel)
PROXY_SECRET=
# Vercel Cron → GET /api/v1/jobs/reminders with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
